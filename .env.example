# Copy to .env and adjust. Never commit real secrets.

# Docker Compose only: password for the local Postgres container (choose your own)
POSTGRES_PASSWORD=

# sqlite+aiosqlite for local dev, postgresql+asyncpg in Docker
DATABASE_URL=sqlite+aiosqlite:///./voiceops.db
# DATABASE_URL=postgresql+asyncpg://voiceops:voiceops@localhost:5432/voiceops

# "inprocess" calls the mock systems through ASGI without a network hop.
# In Docker Compose this points at the separate mock-systems container.
MOCK_API_BASE_URL=inprocess
# Outbound calls: per-attempt timeout, total budget per call (retries included),
# attempts, full-jitter backoff. POSTs always carry an Idempotency-Key.
INTEGRATION_TIMEOUT_S=3.0
INTEGRATION_DEADLINE_S=6.0
INTEGRATION_MAX_ATTEMPTS=3
INTEGRATION_BACKOFF_BASE_S=0.2
INTEGRATION_BACKOFF_MAX_S=2.0

# mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — start low for voice latency, raise if evals show headroom
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_S=30
# ANTHROPIC_API_KEY=   # read by the SDK from the environment; leave unset to stay on mock
# Voice turns stream the response; tools are then sent with eager_input_streaming
ANTHROPIC_EAGER_TOOL_STREAMING=true

# Speech. mock = no keys, no models (CI, demos)
STT_PROVIDER=mock            # mock | whisper_local | whisper_http
TTS_PROVIDER=mock            # mock | azure
STT_TIMEOUT_S=10
TTS_TIMEOUT_S=8              # max wait for the next audio chunk
# whisper_local (pip install -e ".[voice-local]"): audio never leaves this host
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# whisper_http: any OpenAI-compatible /audio/transcriptions endpoint
WHISPER_HTTP_URL=http://localhost:9000/v1
WHISPER_HTTP_MODEL=Systran/faster-whisper-small
# WHISPER_API_KEY=
# azure: Azure AI Speech neural TTS
# AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_TTS_VOICE_TR=tr-TR-EmelNeural
AZURE_TTS_VOICE_EN=en-US-JennyNeural
AZURE_TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Voice session
VOICE_FILLER_AFTER_MS=900    # say "one moment" if nothing was said yet
VOICE_MIN_CONFIDENCE=0.35    # below this, re-prompt instead of running a turn
VOICE_MAX_UTTERANCE_S=30
VOICE_VAD_THRESHOLD=500      # RMS of 16-bit PCM (pcm16 input with server VAD)
VOICE_VAD_END_SILENCE_MS=700
VOICE_GREETING=true

# Supervisor endpoints (/v1/approvals, /v1/demo/faults) require X-API-Key when set.
# Leave empty only for local development.
SUPERVISOR_API_KEY=
DEMO_ENABLED=true
# Docker sets this to false and runs `alembic upgrade head` instead
DB_AUTO_CREATE=true

# Structured JSON logs (redacted) to stdout
LOG_JSON=true
LOG_LEVEL=INFO
# POLICY_DIR=data/policies

AGENT_MAX_STEPS=6
TIMEZONE=Europe/Istanbul
